--- /dev/null
+++ b/tests/test_chees_metric_fallback.py
@@ -0,0 +1,117 @@
+"""Regressions for structurally singular complement ChEES covariance."""
+
+import importlib
+import importlib.util
+from pathlib import Path
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+
+from affine_invariant_samplers import sampler_peaches, sampler_peams, sampler_pickles
+
+SAMPLERS = [sampler_peaches, sampler_peams, sampler_pickles]
+REFERENCE = Path(__file__).resolve().parents[1] / 'audit/robustness/ensemble_metric/reference'
+
+
+@pytest.fixture
+def x64_mode():
+    previous = jax.config.x64_enabled
+    jax.config.update('jax_enable_x64', True)
+    try:
+        yield
+    finally:
+        jax.config.update('jax_enable_x64', previous)
+
+
+def metric_args(module, complement):
+    if module.__name__.split('.')[-1].startswith('pickles'):
+        return (complement, complement)
+    return (complement, complement, 'affine-invariant')
+
+
+@pytest.mark.parametrize('sampler', SAMPLERS, ids=lambda fn: fn.__name__)
+def test_singular_half_metric_matches_full_covariance_flow_derivative(sampler, x64_mode):
+    module = importlib.import_module(sampler.__module__)
+    current, proposed, velocity, complement = jax.random.normal(jax.random.key(15), (4, 3, 3))
+    covariance = jnp.cov(jnp.concatenate([current, complement]), rowvar=False)
+    assert np.linalg.matrix_rank(np.cov(np.asarray(complement), rowvar=False)) == 2
+    assert np.linalg.matrix_rank(np.asarray(covariance)) == 3
+    lower = jnp.linalg.cholesky(covariance)
+    center_current = current.mean(0)
+    center_proposed = proposed.mean(0)
+    alpha = jnp.exp(jnp.linspace(-.8, 0., 3))
+    time = .4
+
+    # Independently differentiate the squared moment change along the flow.
+    # The metric and centering estimates are fixed during this ChEES derivative.
+    def whiten(points):
+        return jax.scipy.linalg.solve_triangular(lower, points.T, lower=True).T
+
+    def criterion(log_time):
+        moved = proposed + (jnp.exp(log_time) - time) * velocity
+        delta = jnp.sum(whiten(moved - center_proposed)**2, 1) \
+                - jnp.sum(whiten(current - center_current)**2, 1)
+        return jnp.sum(alpha * .25 * delta**2) / (jnp.sum(alpha) + 1e-7)
+
+    state = module._chees_init(.1, 4)
+    result = module._chees_update(
+        state, jnp.log(alpha), current, proposed, velocity,
+        *metric_args(module, complement), trajectory_time=time)
+    expected = jax.grad(criterion)(jnp.log(time))
+    np.testing.assert_allclose(result.m, expected, rtol=2e-12, atol=2e-12)
+
+    transform = jnp.asarray([[2., .3, 0.], [0., .5, 1.1], [.1, 0., 3.]])
+    shift = jnp.asarray([-1., 3., .2])
+    transformed = module._chees_update(
+        state, jnp.log(alpha), current @ transform + shift, proposed @ transform + shift,
+        velocity @ transform, *metric_args(module, complement @ transform + shift),
+        trajectory_time=time)
+    np.testing.assert_allclose(np.asarray(result), np.asarray(transformed), rtol=1e-10, atol=1e-10)
+
+
+@pytest.mark.parametrize('sampler', SAMPLERS, ids=lambda fn: fn.__name__)
+def test_full_rank_complement_retains_original_sampler_behavior(sampler, x64_mode):
+    name = sampler.__name__.removeprefix('sampler_')
+    spec = importlib.util.spec_from_file_location(name + '_reference', REFERENCE / (name + '.py'))
+    reference = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(reference)
+    initial = jax.random.normal(jax.random.key(91), (16, 2))
+    log_prob = lambda x: -.5 * jnp.sum(x*x, axis=-1)
+    settings = dict(warmup=4, step_size=.1, L=3, max_L=16,
+                    find_init_step_size=False, verbose=False, seed=9)
+    old_samples, old_info = getattr(reference, sampler.__name__)(log_prob, initial, 4, **settings)
+    samples, info = sampler(log_prob, initial, 4, **settings)
+    np.testing.assert_array_equal(samples, old_samples)
+    assert info == old_info
+
+
+@pytest.mark.parametrize('sampler', SAMPLERS, ids=lambda fn: fn.__name__)
+def test_collinear_full_ensemble_does_not_gain_artificial_rank(sampler, x64_mode):
+    module = importlib.import_module(sampler.__module__)
+    current = complement = jnp.ones((3, 3))
+    state = module._chees_init(.1, 4)
+    result = module._chees_update(
+        state, jnp.zeros(3), current, 2 * current, current,
+        *metric_args(module, complement), trajectory_time=.4)
+    assert result.m == 0 and result.v == 0
+
+
+@pytest.mark.parametrize('sampler', SAMPLERS, ids=lambda fn: fn.__name__)
+def test_globally_insufficient_ensemble_keeps_singular_metric_explicit(
+        sampler, monkeypatch, x64_mode):
+    module = importlib.import_module(sampler.__module__)
+    current, proposed, velocity, complement = jax.random.normal(jax.random.key(92), (4, 3, 8))
+    original_cov = jnp.cov
+    sizes = []
+
+    def record_cov(points, *args, **kwargs):
+        sizes.append(len(points))
+        return original_cov(points, *args, **kwargs)
+
+    monkeypatch.setattr(jnp, 'cov', record_cov)
+    module._chees_update(
+        module._chees_init(.1, 4), jnp.zeros(3), current, proposed, velocity,
+        *metric_args(module, complement), trajectory_time=.4)
+    assert sizes == [3]  # N=6 <= D=8: full covariance cannot have full rank either.
